import("//build/boards/${board}.gni")
import("//build/templates/build_template.gni")
import("//build/toolchain/blueos.gni")

# Keep execution checks within the profiles published by this crate. Both the
# integration test and the unit test image are booted under the board QEMU.
_loader_execution_enabled = board_toolchain_info.current_cpu == "riscv32" ||
                            board_toolchain_info.current_cpu == "riscv64" ||
                            board_toolchain_info.current_cpu == "aarch64"

group("check_loader") {
  testonly = true
  deps = []
  if (_loader_execution_enabled) {
    deps += [
      ":run_loader_unittest",
      "tests:run_loader_integration_test",
    ]
  }
}

group("inputs") {
  testonly = true
  deps = [ "tests/inputs" ]
}

if (coverage || profile) {
  build_rust("common_cov") {
    crate_type = "rlib"
    sources = [ "tests/cov/lib.rs" ]
    deps = [
      "//external/rust:minicov",
      "//external/rust:semihosting",
    ]
  }
}

build_rust("blueos_loader") {
  crate_type = "rlib"
  sources = [ "src/lib.rs" ]
  deps = [ "//external/rust:goblin" ]
}

run_clippy("blueos_loader_clippy") {
  deps = [ ":blueos_loader" ]
}

if (_loader_execution_enabled) {
  build_rust("loader_unittest") {
    testonly = true
    crate_type = "bin"
    edition = "2021"
    sources = [ "src/lib.rs" ]
    deps = [
      "//external/rust:goblin",
      "//external/rust:semihosting",
      "//kernel/infra:blueos_infra",
      "//kernel/rsrt",
      "//libs/librs",
    ]

    if (board == "qemu_virt64_aarch64") {
      deps += [ "//build/boards/qemu_virt64_aarch64:default_linker_script" ]
    }
    configs += [ "//build/boards/${board}:kernel_config" ]
    rustflags = [ "--test" ]
    linker_script = default_linker_script
    proc_macro_deps = [ "//kernel/test_harness:blueos_test_macro" ]
  }

  if (defined(qemu_use_esp32_loader) && qemu_use_esp32_loader) {
    gen_esp32_qemu_runner("loader_unittest_runner") {
      testonly = true
      elf = ":loader_unittest"
      chip = "${chip}"
      bootloader = qemu_esp32_bootloader_bin
      partition_table = qemu_esp32_partition_table_bin
      qemu = qemu_exe
      machine = qemu_machine
      semihosting = true
      qemu_args = qemu_extra_args
      net_args = qemu_net_args
      block_args = qemu_block_args
    }
  } else {
    gen_qemu_runner("loader_unittest_runner") {
      testonly = true
      img = ":loader_unittest"
      qemu = qemu_exe
      machine = qemu_machine
      semihosting = true
      qemu_args = qemu_extra_args
      block_img = "loader_unittest_block.img"
      block_args = qemu_block_args
    }
  }

  run_qemu_check("run_loader_unittest") {
    testonly = true
    runner = ":loader_unittest_runner"
    checker = "src/unittests.checker"
  }

  run_clippy("loader_unittest_clippy") {
    testonly = true
    deps = [ ":loader_unittest" ]
  }
}

group("check_loader_by_clippy") {
  testonly = true
  deps = [ ":blueos_loader_clippy" ]
  if (_loader_execution_enabled) {
    deps += [
      ":loader_unittest_clippy",
      "tests/integration_test:loader_integration_test_clippy",
    ]
  }
  if (coverage || profile) {
    deps += [ ":common_cov" ]
  }
}
